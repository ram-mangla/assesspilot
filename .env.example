# QuizAgent Environment Variables Template
# Copy this file to .env or set these in your shell/CI environment.

# AI Provider API Keys (Practice assistance and question analysis)
# NVIDIA NIM API key (Free developer tier available at https://build.nvidia.com)
NVIDIA_API_KEY=nvapi-your-key-here

# OpenRouter API key (Access to free and paid open-source models at https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional: Assessment credentials (prefer environment variable over CLI arguments)
# QA_USER=your_username
# QA_PASS=your_password_here

# Optional: Default Remote Debugging Port for Chrome DevTools Protocol
# QA_CDP_PORT=9222
